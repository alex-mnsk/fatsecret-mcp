FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
PORT=3333
# Keep on localhost until you add proper HTTPS and authentication.
HOST=127.0.0.1
# Must match the redirect URL registered with FatSecret (if required).
CALLBACK_URL=http://127.0.0.1:3333/auth/callback
# Optional: protects the read-only data endpoints if exposed beyond localhost.
API_KEY=

# Cloud MCP: separate GitHub OAuth app for owner sign-in. No repository scopes.
# Callback: https://<worker>.<subdomain>.workers.dev/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Numeric permanent GitHub user ID, not the login name.
OWNER_GITHUB_ID=
